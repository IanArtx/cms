%% v1.60.0 — Investments/MMF light unification + bond term identifier
%% Two independent sub-features requested together. Top half: the
%% unified creation modal + merged list/stats. Bottom half: bond term
%% assignment (new bonds vs. the one-time migration backfill for
%% already-entered bonds).
flowchart TD

    subgraph UNIFY["Light unification — UI/reporting layer only"]
        direction TB
        A["User opens 'Add Investment'\n(CreateInvestmentModal)"] --> B{Picks type\n(gated by permission held)}
        B -->|Standard\nINVESTMENT_CREATE| C1[Planned budget, funding account\nSecondary accounts only]
        B -->|Bond\nINVESTMENT_CREATE| C2["Bond Details block\n+ required Term quick-pick\n(2/3/5/10/15/20/25yr)"]
        B -->|MMF\nMMF_MANAGE| C3["Provider, Parent account\n(Primary or Secondary)\noptional 'Fund Now'"]

        C1 --> D1["POST /investments\n(investment_type=STANDARD)"]
        C2 --> D2["POST /investments\n(investment_type=BOND,\nbond_term_years required)"]
        C3 --> D3[POST /mmf]

        D1 & D2 --> E1[(investments table)]
        D3 --> E2[(mmf_accounts / mmf_transactions)]

        E1 --> F["InvestmentsPage.jsx loads both\ninvestmentsAPI.getAll + mmfAPI.getAll\n(parallel, each skipped if permission missing)"]
        E2 --> F
        F --> G["Client-side merge + sort by created_at\none 'rows' array, each tagged\nkind: STANDARD | BOND | MMF"]
        G --> H["One unified list + Portfolio Overview\n(getPortfolioSummary now UNIONs\ninvestments + mmf_accounts)"]
    end

    subgraph TERM["Bond term identifier"]
        direction TB
        T1{Bond term known\nat creation?}
        T1 -->|Yes| T2["Saved directly:\nbond_term_years = 2/3/5/10/15/20/25"]
        T1 -->|"Legacy bond\n(pre-v1.60.0)"| T3["migration_v1.60.0.sql backfill:\nnearest of the 7 buckets vs\nstart_date/expected_end_date"]
        T3 --> T4{Within 6-month\ntolerance?}
        T4 -->|Yes| T5[bond_term_years set\nautomatically]
        T4 -->|"No / dates missing"| T6[Left NULL —\nflagged for manual review]
        T6 --> T7["Amber banner + 'Set Term' link\non BondScheduleCard\n(InvestmentDetailPage.jsx)"]
        T7 --> T8["SetBondTermModal —\nquick-pick one of the 7 terms"]
        T8 --> T9["PATCH /investments/:id/bond-term\n(INVESTMENT_MANAGE, logged)"]
        T2 --> T10[(investments.bond_term_years)]
        T5 --> T10
        T9 --> T10
    end

    style T6 fill:#fef9c3
    style T7 fill:#fef9c3
    style H fill:#dcfce7
    style T10 fill:#dcfce7
