%% v1.75.0 — smoother password and email-address changes
flowchart TD
    subgraph PW["Change password (Profile › Password & Email)"]
        P1["current password + new password twice\nlive rules checklist · show/hide"] --> P2{"current correct?\nrules met? different?"}
        P2 -- no --> P3["400 — plain-language reason"]
        P2 -- yes --> P4["users.password_hash updated\nsession_version + 1 · password_changed_at"]
        P4 --> P5["new tokens for THIS device\n(stays signed in)"]
        P4 --> P6["email: 'your password was changed'\n+ reset button if it wasn't you"]
        P1 -. "forgot current password" .-> F1["Email me a reset link\n(1 hour)"]
    end

    subgraph RS["Forgot password → reset link"]
        F1 --> F2["/reset-password?token=…\nsame rules checklist"] --> F3["password set · session_version + 1\nevery device signed out"]
    end

    subgraph SV["Every request / token refresh"]
        S1{"token.sv = users.session_version?"} -- yes --> S2["carry on"]
        S1 -- no --> S3["401 SESSION_REVOKED"] --> S4["browser → /login?signedOut=password\n'You were signed out because the password was changed'"]
        S5["tokens from before v1.75 have no sv\n= 0 = default → still valid"] --> S1
    end
    P4 -. "older sign-ins now mismatch" .-> S1
    F3 -.-> S1

    subgraph EM["Change email address"]
        E1["Member: new address + password\n(+ 2FA code if 2FA is on)"] --> E3
        E2["Admin (Members › Change Email):\nnew address + reason (required)\nnever on own account"] --> E3
        E3["email_change_requests PENDING\n(one per member — a new one SUPERSEDES)\nonly SHA-256 hashes of the link tokens stored"]
        E3 --> E4["NEW address: confirm link (48 h)"]
        E3 --> E5["OLD address: notice (+ Admin reason)\n+ 'I didn't ask for this' link"]
        E4 --> E6["/confirm-email-change → press button\nusers.email changed · CONFIRMED\nboth addresses told · audit log"]
        E5 --> E7{"/cancel-email-change → press button"}
        E7 -- "still PENDING" --> E8["CANCELLED — nothing changed"]
        E7 -- "CONFIRMED ≤ 7 days ago" --> E9["REVERTED: old email back ·\npassword locked · session_version + 1 ·\nreset link to OLD address"]
        E3 -. "48 h pass" .-> E10["EXPIRED"]
    end
