flowchart TD
    subgraph A["1. The problem — transactions is single-leg"]
        A1["Every transactions row records\nONE account + a fixed inflow_type\n(CONTRIBUTION, EXPENSE, LOAN_DISBURSED...)"] --> A2["Never a formal double-entry book —\nno foundation for a real Balance Sheet,\nTrial Balance, or General Ledger"]
    end

    subgraph B["2. Chart of Accounts foundation (new)"]
        B1["gl_accounts — 23 GL accounts\n1000s Asset / 2000s Liability / 3000s Equity\n4000s Revenue / 5000s Expense"] --> B3["gl_inflow_type_mapping —\nall 31 inflow_type values,\neach mapped to a GL account"]
        B3 --> B4["Editable review page\n(Reports -> Financial Statements ->\nLedger Accounts, SYSTEM_CONFIG)"]
    end

    subgraph C["3. glService.js derives double-entry on demand"]
        C1["Every transaction becomes 2 lines"] --> C2["Line A: always Cash and Bank (1000),\nattributed to the real account hit"]
        C1 --> C3["Line B: the mapped GL account\nfor that inflow_type —\nalways the opposite side of Line A"]
        C4["ONE override: EXPENSE + investment_id\nset -> reclassified to 1400\n(Other Investments), not 5000 Expense"] -.-> C3
    end

    subgraph D["4. Two non-cash adjusting entries"]
        D1["Grant recognition: reuses existing\ngrants.is_conditional /\ngrant_conditions.status (MET/WAIVED)\nDebit Deferred Grant Income (2300)\nCredit Grant Income (4200)"]
        D2["Advance recovery: reads\nservice_fee_advance_recoveries.applied_at\nDebit Service Fees Paid (5300)\nCredit Advances Receivable (1200)"]
    end

    subgraph E["5. Five reports — company-wide or per account"]
        E1["Trial Balance\n(cumulative, as of a date)"]
        E2["General Ledger\n(full detail + running balance)"]
        E3["Balance Sheet\n(cumulative, as of a date)"]
        E4["Income Statement\n(date range)"]
        E5["Cash Flow Statement\n(Direct Method, date range,\ntransfers excluded)"]
    end

    subgraph F["6. Built-in reconciliation checks"]
        F1["Balance Sheet: ledger cash (1000+1050)\nvs accounts.current_balance"]
        F2["Balance Sheet: Assets =\nLiabilities + Equity"]
        F3["Cash Flow: computed net change\nvs actual opening/closing ledger cash"]
        F4["Any mismatch is shown\nDIRECTLY on the report"]
    end

    A2 --> B1
    B4 --> C1
    C2 --> E1
    C3 --> E1
    D1 --> E1
    D2 --> E1
    E1 --> E2
    E1 --> E3
    E3 --> F1
    E3 --> F2
    E1 --> E4
    E1 --> E5
    E5 --> F3
    F1 --> F4
    F2 --> F4
    F3 --> F4

    style A2 fill:#fee2e2,stroke:#dc2626
    style B4 fill:#dbeafe,stroke:#2563eb
    style C4 fill:#fef3c7,stroke:#d97706
    style D1 fill:#fef3c7,stroke:#d97706
    style D2 fill:#fef3c7,stroke:#d97706
    style F4 fill:#ecfdf5,stroke:#059669
