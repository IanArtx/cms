# ============================================================
# COMPANY MANAGEMENT SYSTEM — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cms_db
DB_USER=cms_user
DB_PASSWORD=your_database_password
DB_SSL=false              # Set to true in production

# --- JWT Authentication ---
JWT_SECRET=your_very_long_random_jwt_secret_at_least_64_characters
JWT_EXPIRES_IN=8h         # How long a login session lasts
JWT_REFRESH_SECRET=your_very_long_random_refresh_secret_also_64_characters
JWT_REFRESH_EXPIRES_IN=7d

# --- Bcrypt ---
BCRYPT_ROUNDS=12          # Higher = more secure but slower. 12 is the recommended minimum.

# --- Two-Factor Authentication ---
TOTP_APP_NAME=CompanyMS   # Name shown in the authenticator app

# --- Email (Gmail SMTP) ---
GMAIL_USER=yourcompany@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password   # Generate in Gmail > Security > App Passwords

# --- Frontend URL (for email links) ---
FRONTEND_URL=http://localhost:3000            # Change to production domain when live

# --- Backend URL (for absolute asset links inside server-rendered
#     PDFs/emails, e.g. the company logo on a certificate — headless
#     Chrome has no browser origin to resolve a relative /uploads/...
#     path against, so this must be a full, publicly reachable URL) ---
BACKEND_URL=http://localhost:5000              # Change to production domain when live

# --- File Storage ---
UPLOAD_DIR=./uploads      # Local-disk FALLBACK only, used when the S3_* vars below aren't set (e.g. local dev)
MAX_FILE_SIZE_MB=20       # Maximum upload file size in megabytes

# --- File Storage: S3-compatible object store (v1.29.1) ---
# Fill these in to move uploads off local disk and onto Cloudflare R2
# (or any other S3-compatible provider — AWS S3, Backblaze B2,
# DigitalOcean Spaces all work the same way). Required in production,
# since Render's disk is wiped on every redeploy. Leave all four blank
# to keep using local disk (fine for local development).
# See DEPLOYMENT_GUIDE.md's "File storage (Cloudflare R2)" section for
# a step-by-step signup walkthrough.
S3_ENDPOINT=              # e.g. https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=                # e.g. cms-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto            # R2 always uses "auto"; AWS S3/other providers use a real region (e.g. us-east-1)

# --- Monthly Report Schedule (cron syntax) ---
# Default: 1st of every month at 8:00 AM
MONTHLY_REPORT_CRON=0 8 1 * *

# --- Company Info (used in emails and reports) ---
COMPANY_NAME=Your Company Name
COMPANY_EMAIL=yourcompany@gmail.com
COMPANY_ADDRESS=Your Company Address
